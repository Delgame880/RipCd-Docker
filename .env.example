# Copy to .env next to docker-compose.yml and adjust.
# Every variable is optional - the defaults already work on a stock ZimaOS.
#   cp .env.example .env && nano .env && docker compose up -d
#
# The two things that are NOT in here on purpose are the CD drive devices:
# they have to be listed in the `devices:` block of docker-compose.yml, because
# Docker needs them at container creation time.

# ---- where the music and the settings live ---------------------------------
# Share that is mounted into the container as /media (music goes below here)
MEDIA_DIR=/DATA/Media
# Folder for settings, rip history, metadata and cover cache (mounted at /config)
APPDATA_DIR=/DATA/AppData/ripcd

# ---- web ui ----------------------------------------------------------------
# Host port for http://<server>:<port>
WEBUI_PORT=8080
# Optional password. Set it and open http://<server>:8080/?token=<value> once.
RIPCD_TOKEN=
# Log timestamps, e.g. Europe/Madrid, America/Bogota
TZ=UTC

# ---- defaults --------------------------------------------------------------
# Output format: flac, alac, wav, mp3, ogg, opus, aac
RIPCD_FORMAT=flac
# Folders the built-in browser may show (comma separated, keep in sync with the
# volumes above - RipCD refuses to write outside of this sandbox)
RIPCD_MEDIA_ROOTS=/media
# Default destination of the rips, changeable in the UI
RIPCD_OUTPUT_DIR=/media/Music
# Seconds between disc scans (2-120)
RIPCD_POLL_INTERVAL=5
# Identification sent to the MusicBrainz API (your e-mail or homepage - they
# ask for it, it is polite and lets them contact you if something is wrong)
RIPCD_MUSICBRAINZ_CONTACT=
# 1 = demo mode: no CD drive needed, the discs are simulated
RIPCD_MOCK=0
# 1 = verbose logging, useful when something does not work
RIPCD_DEBUG=0

# ---- file ownership --------------------------------------------------------
# 0/0 runs as root (simple, files are owned by root).
# Set to your ZimaOS user ids to own the ripped files: run `id` on the host.
PUID=1000
PGID=1000
# File permissions created by the container (022 -> rw-r--r--)
UMASK=022
